NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (anon) key — server reads via public.get_latest_platform_snapshot() RPC.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if you run scripts/publish_platform_snapshot.py from this folder.
# The deployed Next.js app does NOT need the service-role key.
SUPABASE_SERVICE_ROLE_KEY=optional-only-for-publish-script
REVALIDATE_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://schedule-platform.vercel.app
